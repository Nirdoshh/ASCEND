# Cloudflare Workers Static Assets headers
#
# Why this file exists:
#   wrangler.jsonc sets run_worker_first to ["/api/*"] so static assets
#   are served directly by the assets binding. That is the free-plan
#   friendly choice, but it also means our Worker function never runs
#   for asset requests, so the headers set in worker/index.ts do NOT
#   apply to HTML, CSS or JS.
#
#   This file is where asset headers belong. The duplication with
#   worker/index.ts is intentional and cross-referenced in both files.
#   If you change a header in one, change it in the other.
#
# NOTE: Content-Security-Policy is deliberately absent.
#   It is specified in docs/security-headers.md and lands in Phase 13,
#   when end-to-end tests exist to prove it does not break the app.
#   Shipping a Content-Security-Policy we cannot verify is worse than
#   shipping none, because a wrong policy fails silently in production.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# Hashed build assets are immutable: their filename changes when their
# content changes, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must never be cached, or a deploy would not reach
# anyone whose browser had the old one cached.
/index.html
  Cache-Control: no-cache
